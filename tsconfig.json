{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    // Presentation is React (ADR-0001 §Decision 7, ADR-0017). The automatic runtime keeps
    // components free of a React import they never use directly.
    "jsx": "react-jsx",

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@platform/*": ["src/platform/*"],
      "@contexts/*": ["src/contexts/*"],
      "@app": ["src/app/index.ts"],
      "@app/*": ["src/app/*"],
      "@presentation": ["src/presentation/index.ts"],
      "@presentation/*": ["src/presentation/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*.ts", "scripts/**/*.tsx", "vitest.config.ts"]
}
