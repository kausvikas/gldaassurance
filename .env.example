# Configuration for the trusted runtime. No value here is a secret — this file records the keys.
# The real values are injected by the environment or a secret store (REQ-SEC-008, ADR-0010 §6).

GLDI_ENV=dev
GLDI_AS_OF_DATE=2026-08-31

# Exact origins permitted to call the API. Empty means same-origin only; there is no wildcard.
GLDI_ALLOWED_ORIGINS=

# claude | local | none. `none` is a working configuration: answers are composed by the governed
# deterministic composer and the response says so.
AI_PROVIDER=none

# Server-side only. Never in client JavaScript, never in HTML, never logged.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# A local inference runtime inside the deployment boundary.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_PROTOCOL=openai-compatible

# Whether any material may leave this deployment for a hosted model. Defaults to false: a deployment
# that has not said yes has said no.
GLDI_EXTERNAL_AI_ALLOWED=false

# The narrow, explicit local-to-external fallback of ADR-0033 §4. Refused at start-up unless
# GLDI_EXTERNAL_AI_ALLOWED is also true. There is no configuration that produces a silent fallback.
GLDI_LOCAL_TO_EXTERNAL_FALLBACK=false
