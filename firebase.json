{
  "hosting": {
    "public": "dist/executive-poc",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/interventions",
        "destination": "/index.html"
      },
      {
        "source": "/portfolio",
        "destination": "/portfolio-command-center.html"
      },
      {
        "source": "/green-at-risk",
        "destination": "/portfolio-command-center.html"
      },
      {
        "source": "/projects",
        "destination": "/project-executive-health.html"
      },
      {
        "source": "/financial",
        "destination": "/margin-intelligence.html"
      },
      {
        "source": "/early-warnings",
        "destination": "/forward-risk.html"
      },
      {
        "source": "/recovery",
        "destination": "/forward-risk.html"
      },
      {
        "source": "/assistant",
        "destination": "/delivery-assistant.html"
      },
      {
        "source": "/gallery",
        "destination": "/component-gallery.html"
      },
      {
        "source": "/assurance",
        "destination": "/not-in-poc.html"
      },
      {
        "source": "/data-quality",
        "destination": "/not-in-poc.html"
      },
      {
        "source": "/rules",
        "destination": "/not-in-poc.html"
      },
      {
        "source": "/benchmarks",
        "destination": "/not-in-poc.html"
      },
      {
        "source": "/deal-intelligence",
        "destination": "/not-in-poc.html"
      },
      {
        "source": "/administration",
        "destination": "/not-in-poc.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
          }
        ]
      }
    ]
  }
}
